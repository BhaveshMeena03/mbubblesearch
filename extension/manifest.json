{
  "manifest_version": 3,
  "name": "MarketBubbleSearch for X",
  "short_name": "MBSearch",
  "version": "1.0.1",
  "description": "Summaries, answers and where clips came from, for Market Bubble, MCG, ThreadGuy and rasmr on X. Every time plays at its second.",
  "homepage_url": "https://search.lexthedev.com",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
